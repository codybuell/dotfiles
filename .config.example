                                                # GO
PATH06 = {{ OSHomeRoot }}{{ OSUsername }}/.go/pkg # go path scaffolding
PATH07 = {{ OSHomeRoot }}{{ OSUsername }}/Sources # third party repos (go get...)

                                                # CLAUDE CODE
PATH08 = {{ OSHomeRoot }}{{ OSUsername }}/.claude # claude code config dir

                                                # CODEX CLI
PATH10 = {{ OSHomeRoot }}{{ OSUsername }}/.codex # codex cli config dir


################################################################################
#                                                                              #
# Symlinks                                                                     #
#                                                                              #
# Targets: `make symlinks`                                                     #
#                                                                              #
# You can create unlimited symlinks, simply increment the variable name.       #
# Each symlink should be in the format:                                        #
#                                                                              #
#     SYMLINK[NN] = [source path]:[destination path]                           #
#                                                                              #
# Destination parent folders must already exist, use path configs above as     #
# needed. Do not escape spaces in your paths, ~ or ${home} expansion will not  #
# work, so fully path out. As a helper the script will be run from your home   #
# directory so DESTINATION paths can be defined relative from there.           #
#                                                                              #
################################################################################


SYMLINK00 = {{ OSHomeRoot }}{{ OSUsername }}/Library/CloudStorage/GoogleDrive-cody@codybuell.com/My Drive/Resources/Codex:Codex
SYMLINK01 = {{ OSHomeRoot }}{{ OSUsername }}/Library/CloudStorage/GoogleDrive-cody@codybuell.com/My Drive:Google Drive
SYMLINK02 = {{ HOMEBREW_PREFIX }}/bin/neomutt:{{ HOMEBREW_PREFIX }}/bin/mutt
SYMLINK03 = {{ OSHomeRoot }}{{ OSUsername }}/Bin:{{ OSHomeRoot }}{{ OSUsername }}/.go/bin
SYMLINK04 = {{ OSHomeRoot }}{{ OSUsername }}/Sources:{{ OSHomeRoot }}{{ OSUsername }}/.go/src
SYMLINK05 = {{ CONFIGDIR }}/claude/settings.json:{{ OSHomeRoot }}{{ OSUsername }}/.claude/settings.json
SYMLINK06 = {{ CONFIGDIR }}/claude/hooks:{{ OSHomeRoot }}{{ OSUsername }}/.claude/hooks
SYMLINK07 = {{ CONFIGDIR }}/claude/commands:{{ OSHomeRoot }}{{ OSUsername }}/.claude/commands
SYMLINK08 = {{ CONFIGDIR }}/claude/CLAUDE.md:{{ OSHomeRoot }}{{ OSUsername }}/.claude/CLAUDE.md
SYMLINK09 = {{ CONFIGDIR }}/codex/config.toml:{{ OSHomeRoot }}{{ OSUsername }}/.codex/config.toml
SYMLINK10 = {{ CONFIGDIR }}/claude/themes:{{ OSHomeRoot }}{{ OSUsername }}/.claude/themes


