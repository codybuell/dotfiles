VaultServer  = vaultserver.tld


################################################################################
#                                                                              #
# Paths                                                                        #
#                                                                              #
# Targets: `make paths`                                                        #
#                                                                              #
# You can create unlimited paths, simply increment the variable name.  Paths   #
# are created with the -p flag, so all subdirs will be created as needed. Use  #
# the format:                                                                  #
#                                                                              #
#     PATH[NN] = [path]                                                        #
#                                                                              #
################################################################################


                                                # CODE STORAGE
PATH00 = {{ OSHomeRoot }}{{ OSUsername }}/Repos # repository folder
PATH01 = {{ OSHomeRoot }}{{ OSUsername }}/Gists # github gists folder

                                                # EMAIL
PATH02 = {{ OSHomeRoot }}{{ OSUsername }}/.mail/Home # mutt mail directory
PATH03 = {{ OSHomeRoot }}{{ OSUsername }}/.mail/Kion # mutt mail directory
PATH09 = {{ OSHomeRoot }}{{ OSUsername }}/.mail/Desert # mutt mail directory

                                                # VIRTUALIZATION
PATH04 = {{ OSHomeRoot }}{{ OSUsername }}/Machines # vm data directory

                                                # PATHING
