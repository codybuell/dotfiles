################################################################################
################################################################################
##                                                                            ##
##  Dotfiles Configuration File                                               ##
##                                                                            ##
##  Use this configuration file to customize the resources in this repo to    ##
##  your needs. Throughout the various dotfiles are variables in the format   ##
##  `{{ VarName }}` that will be replaced with the values below when running  ##
##  `make dots`. Values defined here can also be used by other make targets   ##
##  such as `make paths`, see inline comments for more information.           ##
##                                                                            ##
##  Inline comments are allowed. Blank lines are ignored. Tailing spaces are  ##
##  stripped. Wrapping double quotes are removed. Items are case sensitive.   ##
##                                                                            ##
################################################################################
################################################################################


################################################################################
#                                                                              #
# General Information                                                          #
#                                                                              #
################################################################################


Name       = Cody Buell                   # your full name
Email      = cody@codybuell.com           # preferred email
WorkEmail  = your@workemail.com           # work email address (for git config)
OSUsername = pbuell                       # your system username
IRCNick    = pbuell,Cody                  # your irc nicknames, comma separated
OSHomeRoot = /Users/                      # /Users/ on osx /home/ on linux
Team       = UserA,UserB,UserC            # irc names of team members for alias


################################################################################
#                                                                              #
# API Tokens                                                                   #
#                                                                              #
# Targets: `make secrets`                                                      #
#                                                                              #
# Secrets live in 1Password and are copied into the OSX keychain by            #
# `make secrets`; the shell reads them from the keychain at startup (see       #
# dotfiles/zsh/modules/05-environment.zsh). Nothing sensitive is stored here   #
# or in any deployed file, so these keys are safe to read.                     #
#                                                                              #
# Each entry is `<op item uuid>:<field>:<keychain service name>`. Item uuids    #
# come from `op item list --vault <vault>`; using uuids rather than titles      #
# keeps the reference stable across renames and sidesteps op's refusal to      #
# parse titles containing parentheses.                                         #
#                                                                              #
# Re-run `make secrets` after rotating a key in 1Password.                     #
#                                                                              #
################################################################################


SecretsVault = YourVault                    # 1password vault holding the below

# shell env var        # op item uuid                 : field   : keychain service
GitHubHomebrewAPIToken = abcdefghijklmnopqrstuvwxyz:api key:GitHub API Token
OpenAIAPIKey           = abcdefghijklmnopqrstuvwxyz:api key:OpenAI API Key
AnthropicAPIKey        = abcdefghijklmnopqrstuvwxyz:api key:Claude API Key


################################################################################
#                                                                              #
# Git                                                                          #
#                                                                              #
# Targets: `make dots [gitconfig|zsh|shell|imapfilter]`                        #
#                                                                              #
# Your git information. Used for gitconfig, imapfilters, shell $CDPATH, shell  #
# completion, shell navigation, linux builds, etc.                             #
#                                                                              #
################################################################################


GitUsername = codybuell                                # github username
GitSignKey  = 0555DEBF3BE6281EAB1E44DE74DC8D3B3B3F03FE # gpg key to sign commits

WorkGitUsername = pbuell
WorkGitSignKey  = 1234567891234567891234567891234567891234
WorkSchemaHost  = schema.workemail.com                 # yaml schema host for work repos (nvim yamlls)


################################################################################
#                                                                              #
# Email                                                                        #
#                                                                              #
# Targets: `make dots [mutt|imapfilter|mbsyncrc|msmtprc]`                      #
#                                                                              #
# A combination of tools are used to sort, index, read, and send email. Any    #
# number of accounts is supported: list them in MailAccounts below and give    #
# each a matching <Name>Email* key block. Generic single-account stanzas in    #
# mbsyncrc, msmtprc, and the mutt configs are expanded to one block per        #
# account by scripts/mailgen.py during `make dots`, so account names only      #
# ever exist here (encrypted) and in the deployed files.                       #
#                                                                              #
# Adding an account:                                                           #
#                                                                              #
# 1. Add `name:go-key[:flags]` to MailAccounts and a <Name>Email* key block    #
#    below (Name = capitalized account name; go-key = mutt g<key> macro).      #
#                                                                              #
# 2. Write its filter rules in dotfiles/imapfilter/<name>.lua (git-cipher      #
#    encrypted, so real addresses are fine there).                             #
#                                                                              #
# 3. Create an 'application password' record in OSX Keychain Access:           #
#                                                                              #
#    - use `make keychain` (walks the MailAccounts list)                       #
#                                                                              #
#    OR MANUALLY                                                               #
#                                                                              #
#    - open keychain access                                                    #
#    - create new application password, set:                                   #
#      - name / keychain item name = the <Name>EmailHost setting below         #
#      - account / account name    = the <Name>EmailKeychain setting below     #
#      - password                  = the email account's password              #
#                                                                              #
# 4. Run `make dots mbsyncrc msmtprc imapfilter mutt` and restart the mail     #
#    session (the tmux control window builds one sync pane per account).       #
#                                                                              #
# Also required once: passage (pulled and built by `make go`).                 #
#                                                                              #
# Some common service configurations:                                          #
#                                                                              #
#    *EmailSmtp = smtp.gmail.com          # gmail                              #
#    *EmailHost = imap.gmail.com          # gmail                              #
#    *EmailSmtp = smtp.office365.com      # microsoft office 365               #
#    *EmailHost = outlook.office365.com   # microsoft office 365               #
#                                                                              #
################################################################################


# Account slots: name:go-key[:flags], comma separated. Each name needs a
# matching set of <Name>Email* keys below and an imapfilter rules file
# (dotfiles/imapfilter/<name>.lua). go-key drives the mutt g<key> switch
# macro. Flags: slow-archive = big account, sync All Mail hourly not every
# cycle; nosync = keep the account and local mail browsable in mutt but
# start no sync pane and pull nothing (departed employers, dead accounts).
# Expanded into mbsyncrc/msmtprc/mutt configs by scripts/mailgen.py.
MailAccounts        = home:h, work:w:slow-archive, other:o

DefaultEmailAccount = home                        # matches a MailAccounts name
DefaultEmailAccCaps = Home                        # same, capitalized
DefaultEmailAddress = your@email.com

# Home / Personal Email Account
HomeEmailSmtp       = smtp.gmail.com              # outgoing main server
HomeEmailHost       = imap.gmail.com              # host & 'name' field in keychain
HomeEmailKeychain   = cody+mutt@codybuell.com     # 'account' field in keychain
HomeEmailUsername   = cody@codybuell.com
HomeEmailAddress    = cody@codybuell.com
HomeEmailVips       = vip1@email.com,vip2@email.com # comma separated, imapfilter flags mail from these senders

# Kion Email Account
KionEmailSmtp       = smtp.gmail.com              # outgoing main server
KionEmailHost       = imap.gmail.com              # host & 'name' field in keychain
KionEmailKeychain   = you+mutt@workemail.com      # 'account' field in keychain
KionEmailUsername   = your@workemail.com
KionEmailAddress    = your@workemail.com
KionEmailVips       = vip1@email.com,vip2@email.com # comma separated, imapfilter flags mail from these senders

# Desert Email Account
DesertEmailSmtp     = smtp.gmail.com              # outgoing main server
DesertEmailHost     = imap.gmail.com              # host & 'name' field in keychain
DesertEmailKeychain = you+mutt@othersite.com      # 'account' field in keychain
DesertEmailUsername = you@othersite.com
DesertEmailAddress  = you@othersite.com
DesertEmailVips     = vip1@email.com,vip2@email.com # comma separated, imapfilter flags mail from these senders


################################################################################
#                                                                              #
# Locations                                                                    #
#                                                                              #
# Targets: `make dots [zsh zshrc|config/nvim]`                                 #
#                                                                              #
# Common / frequently visited locations that have a mix of automations and     #
# integrations to speed up workflows.                                          #
#                                                                              #
#                                                                              #
# variable          cli   vim    description                                   #
# ---------------------------------------------------------------------------- #
# Notes                   ␣n    general markdown notes / notes vim wiki        #
# Repos             repo        projects that are git repos                    #
# Gists             gist        github gists, snippet repositories             #
#                                                                              #
# * double quote any paths with spaces, for example:                           #
#                                                                              #
#    "~/Google Drive/My Drive/Notes"                                           #
#                                                                              #
# CDPath is a ':' separated list of paths that ZSH autocompletes and wormhole  #
# navigates to. Any paths added below will be appended to the default set in   #
# `dotfiles/zsh/vars`                                                          #
#                                                                              #
#    .:~:~/Repos/github.com/{{ GitUsername }}:{{ CDPath }}                     #
#                                                                              #
# The Repos directory expects to be structured like:                           #
#                                                                              #
#    ${Repos}/[domain]/[username]/[project]                                    #
#                                                                              #
# For example:                                                                 #
#                                                                              #
#    ~/Repos/github.com/codybuell/dotfiles                                     #
#                                                                              #
# To that end there are some helpers built in to make maintenance easiers:     #
#                                                                              #
#    `gcl [repo url]`   - creates paths as needed and then clones the repo     #
#    `repo [repo name]` - cds into the repo, uses autocompletion, auto paths   #
#                                                                              #
################################################################################


Notes           = "~/Codex"
Journal         = "~/Codex/Journal"

Projects        = "~/Google Drive/My Drive/Projects"
Domains         = "~/Google Drive/My Drive/Domains"

Repos           = {{ OSHomeRoot }}{{ OSUsername }}/Repos
WorkRepos       = {{ OSHomeRoot }}{{ OSUsername }}/Repos/git.kion.io
Gists           = {{ OSHomeRoot }}{{ OSUsername }}/Gists

CDPath          = "~/Repos/github.com/codybuell"


################################################################################
#                                                                              #
# Go                                                                           #
#                                                                              #
# Targets: `make dots zshrc shell`  <- configures paths set below              #
#          `make brew`              <- installs the latest version of go       #
#          `make go`                <- installs go packages we want            #
#                                                                              #
# Here we will define our default GOPATH. It's recommended to provide two      #
# paths, the first of which where go get will place its sources, the second    #
# being for your own personal packages. The separation will keep bits cleaner  #
# but ultimately it's your call. For monorepos use direnv to dynamically set   #
# the gopath by placing a .envrc with the exports you want to be set when      #
# in that workspace. Better yet use a newer verion of go that has modules.     #
#                                                                              #
# Old way, place an .envrc in your project root containing:                    #
#                                                                              #
#     export GOPATH=$(pwd)                                                     #
#     export GOBIN=$(pwd)/bin                                                  #
#     export PATH=$PATH:$GOBIN                                                 #
#                                                                              #
# New way, use go modules:                                                     #
#                                                                              #
#     mkdir myproject; cd !$; go mod init myproject                            #
#                                                                              #
################################################################################


GoPath = {{ OSHomeRoot }}{{ OSUsername }}/.go:{{ OSHomeRoot }}{{ OSUsername }}/Repos


################################################################################
