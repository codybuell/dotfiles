defaults
port 587
protocol smtp
auth on
tls on

# one account stanza per entry in the MailAccounts .config key, expanded by
# scripts/mailgen.py at deploy time
# {{% foreach mailaccount %}}
account {{ MailAcct }}
tls_trust_file /etc/ssl/cert.pem
host {{ MailAcctEmailSmtp }}
from {{ MailAcctEmailAddress }}
user {{ MailAcctEmailUsername }}
passwordeval ~/.zsh/bin/get-keychain-pass {{ MailAcctEmailKeychain }} {{ MailAcctEmailHost }}
syslog LOG_MAIL

# {{% endforeach %}}
account default : {{ DefaultEmailAccount }}
