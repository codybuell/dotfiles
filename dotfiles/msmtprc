defaults
port 587
protocol smtp
auth on
tls on

account home
# tls_starttls on
# tls_certcheck off
#tls_trust_file /usr/local/etc/openssl/cert.pem
tls_trust_file /etc/ssl/cert.pem
host {{ HomeEmailSmtp }}
from {{ HomeEmailAddress }}
user {{ HomeEmailUsername }}
passwordeval ~/.zsh/bin/get-keychain-pass {{ HomeEmailKeychain }} {{ HomeEmailHost }}
syslog LOG_MAIL

