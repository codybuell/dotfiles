set copy = no
set folder = ~/.mail
set from = '{{ DefaultEmailAddress }}'
set mbox = '+{{ DefaultEmailAccCaps }}/{{ DefaultEmailAccCaps }}.Archive'
set postponed ='+{{ DefaultEmailAccCaps }}/{{ DefaultEmailAccCaps }}.Drafts'
unset record
set sendmail = 'env BUNDLE_GEMFILE={{ HOMEDIR }}/.mutt/scripts/Gemfile {{ HOMEDIR }}/.mutt/scripts/msmtp.rb -a {{ DefaultEmailAccount }}'
set spoolfile = '+{{ DefaultEmailAccCaps }}/{{ DefaultEmailAccCaps }}'
set trash = '+{{ DefaultEmailAccCaps }}/{{ DefaultEmailAccCaps }}.Trash'

# Normally <delete-pattern>.
macro index,pager D "<shell-escape>~/.mutt/scripts/download.sh {{ DefaultEmailAccount }}<enter><sync-mailbox>" "download messages"

# Per-account folder-hooks, expanded from the MailAccounts .config key by
# scripts/mailgen.py at deploy time. All accounts are Gmail-backed: no record
# (the server saves sent mail; the Sent channel pulls it down).
# {{% foreach mailaccount %}}
folder-hook +{{ MailAcctCaps }}/ set copy = yes
folder-hook +{{ MailAcctCaps }}/ set from = '{{ MailAcctEmailAddress }}'
folder-hook +{{ MailAcctCaps }}/ set mbox = '+{{ MailAcctCaps }}/{{ MailAcctCaps }}.Archive'
folder-hook +{{ MailAcctCaps }}/ set postponed ='+{{ MailAcctCaps }}/{{ MailAcctCaps }}.Drafts'
folder-hook +{{ MailAcctCaps }}/ unset record
folder-hook +{{ MailAcctCaps }}/ set sendmail = 'env\ BUNDLE_GEMFILE=$HOME/.mutt/scripts/Gemfile\ $HOME/.mutt/scripts/msmtp.rb\ -a\ {{ MailAcct }}'
folder-hook +{{ MailAcctCaps }}/ set spoolfile = '+{{ MailAcctCaps }}/{{ MailAcctCaps }}'
folder-hook +{{ MailAcctCaps }}/ set trash = '+{{ MailAcctCaps }}/{{ MailAcctCaps }}.Trash'
folder-hook +{{ MailAcctCaps }}/ macro index,pager D '<shell-escape>~/.mutt/scripts/download.sh\ {{ MailAcct }}<enter><sync-mailbox>' 'download\ messages'

# {{% endforeach %}}

# Guard: Sent folders are append-only. Archiving (e), trashing (#), or
# spamming (!) from a Sent view strips the message's Sent label server-side,
# so neuter those keys there; `m` (move) remains for deliberate action. The
# restore hook must re-source next.mutt because j/k re-source it as they
# navigate, which would otherwise resurrect the archive macro inside Sent --
# hence j/k/J/K are also remapped to non-sourcing variants while in Sent.
folder-hook . 'source ~/.mutt/config/next.mutt'
folder-hook . macro index j '<next-undeleted><enter-command>source\ ~/.mutt/config/next.mutt<enter>' 'next\ undeleted'
folder-hook . macro index k '<previous-undeleted><enter-command>source\ ~/.mutt/config/previous.mutt<enter>' 'previous\ undeleted'
folder-hook . macro pager J '<next-entry><enter-command>source\ ~/.mutt/config/next.mutt<enter>' 'next\ entry'
folder-hook . macro pager K '<previous-entry><enter-command>source\ ~/.mutt/config/previous.mutt<enter>' 'previous\ entry'

# NOTE: the j/k/J/K remaps come before the #/! binds on purpose: an unquoted
# "!" aborts hook execution mid-run (neomutt misparses it and dumps bindings),
# which previously left the re-sourcing j/k macros armed inside Sent.
folder-hook Sent/?$ bind index,pager e noop
folder-hook Sent/?$ macro index j '<next-undeleted>' 'next\ undeleted'
folder-hook Sent/?$ macro index k '<previous-undeleted>' 'previous\ undeleted'
folder-hook Sent/?$ macro pager J '<next-entry>' 'next\ entry'
folder-hook Sent/?$ macro pager K '<previous-entry>' 'previous\ entry'
folder-hook Sent/?$ bind index,pager '\#' noop
folder-hook Sent/?$ macro index,pager '\!' '<redraw-screen>' 'guarded'

# Allow editing of `From:` header in composer to alter sending account.
# {{% foreach mailaccount %}}
send2-hook '~f ^{{ MailAcctEmailAddress }}$' 'set sendmail = "env BUNDLE_GEMFILE=$HOME/.mutt/scripts/Gemfile $HOME/.mutt/scripts/msmtp.rb -a {{ MailAcct }}"; unset record; set copy = no'
# {{% endforeach %}}

# populate mailbox counts immediately so sidebar_non_empty_mailbox_only has
# stats to work with at startup (otherwise the sidebar is empty for the first
# $mail_check_stats_interval seconds)
startup-hook 'exec check-stats'

# sync mailbox every N seconds as defined by set timeout, also sync on startup/shutdown
timeout-hook 'exec sync-mailbox'
#startup-hook 'exec sync-mailbox'
#shutdown-hook 'exec sync-mailbox'
