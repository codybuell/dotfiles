################################################################################
#                                                                              #
# global defaults                                                              #
#                                                                              #
################################################################################

Create Both
Expunge Both
SyncState *

################################################################################
#                                                                              #
# mail accounts                                                                #
#                                                                              #
# One stanza per account, expanded from the MailAccounts key in .config by     #
# scripts/mailgen.py at deploy time. Account/channel/maildir names come from   #
# the account name; connection details from the <Name>Email* config keys.     #
#                                                                              #
################################################################################

# {{% foreach mailaccount %}}
IMAPAccount {{ MailAcctCaps }}
Host {{ MailAcctEmailHost }}
User {{ MailAcctEmailUsername }}
PassCmd "get-keychain-pass {{ MailAcctEmailKeychain }} {{ MailAcctEmailHost }}"
CertificateFile {{ CONFIGDIR }}/assets/system_root_certificates.pem
TLSType IMAPS
AuthMechs LOGIN

IMAPStore {{ MailAcctCaps }}-remote
Account {{ MailAcctCaps }}

MaildirStore {{ MailAcctCaps }}-local
Path ~/.mail/{{ MailAcctCaps }}/
Inbox ~/.mail/{{ MailAcctCaps }}/{{ MailAcctCaps }}

Channel {{ MailAcctCaps }}-{{ MailAcctCaps }}
Far :{{ MailAcctCaps }}-remote:INBOX
Near :{{ MailAcctCaps }}-local:{{ MailAcctCaps }}

Channel {{ MailAcctCaps }}-Drafts
Far :{{ MailAcctCaps }}-remote:"[Gmail]/Drafts"
Near :{{ MailAcctCaps }}-local:{{ MailAcctCaps }}.Drafts

Channel {{ MailAcctCaps }}-Sent
Far :{{ MailAcctCaps }}-remote:"[Gmail]/Sent Mail"
Near :{{ MailAcctCaps }}-local:{{ MailAcctCaps }}.Sent

Channel {{ MailAcctCaps }}-Starred
Far :{{ MailAcctCaps }}-remote:"[Gmail]/Starred"
Near :{{ MailAcctCaps }}-local:{{ MailAcctCaps }}.Starred

Channel {{ MailAcctCaps }}-Spam
Far :{{ MailAcctCaps }}-remote:"[Gmail]/Spam"
Near :{{ MailAcctCaps }}-local:{{ MailAcctCaps }}.Spam

Channel {{ MailAcctCaps }}-Trash
Far :{{ MailAcctCaps }}-remote:"[Gmail]/Trash"
Near :{{ MailAcctCaps }}-local:{{ MailAcctCaps }}.Trash

Channel {{ MailAcctCaps }}-All
Far :{{ MailAcctCaps }}-remote:"[Gmail]/All Mail"
Near :{{ MailAcctCaps }}-local:{{ MailAcctCaps }}.Archive

# Catch-all for everything else: note that the `Patterns` have to exclude both
# the remote and local names for all the folders we want to exclude (except
# "INBOX", which is special-cased, it would seem).
Channel {{ MailAcctCaps }}-Default
Far :{{ MailAcctCaps }}-remote:
Near :{{ MailAcctCaps }}-local:{{ MailAcctCaps }}.
Patterns *
Patterns !INBOX
Patterns ![Gmail]*
Patterns !Archive
Patterns !Drafts
Patterns !Sent
Patterns !Spam
Patterns !Starred
Patterns !Trash

# For doing a quick sync of just the INBOX with `mbsync {{ MailAcctCaps }}-Download`.
Channel {{ MailAcctCaps }}-Download
Far :{{ MailAcctCaps }}-remote:INBOX
Near :{{ MailAcctCaps }}-local:{{ MailAcctCaps }}
Create Near
Expunge Near
Sync Pull

# Lower-case group name to match "~/.imapfilter/{{ MailAcct }}.lua" (see
# "~/.mutt/scripts/sync.sh").
Group {{ MailAcct }}
Channel {{ MailAcctCaps }}-{{ MailAcctCaps }}
Channel {{ MailAcctCaps }}-Drafts
Channel {{ MailAcctCaps }}-Sent
Channel {{ MailAcctCaps }}-Starred
Channel {{ MailAcctCaps }}-Spam
Channel {{ MailAcctCaps }}-Trash
# {{% if slow-archive %}}
Channel {{ MailAcctCaps }}-Default

# Large account: All Mail is kept out of the main group and synced hourly by
# sync.sh via this group (the slow-archive flag in MailAccounts drives both).
Group {{ MailAcct }}-archive
Channel {{ MailAcctCaps }}-All
# {{% else %}}
Channel {{ MailAcctCaps }}-All
Channel {{ MailAcctCaps }}-Default
# {{% endif %}}

# {{% endforeach %}}
